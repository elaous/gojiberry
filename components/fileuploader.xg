package components

import (
	"fmt"

	"github.com/elaous/gojiberry/xango"
)

// FileUploaderProps configures FileUploader.
//
// xango.Event carries no file data (see xango.Event's doc comment: Value
// is only ever a string/bool/similar simple payload), so reading the
// actual selected/dropped files is the caller's job, done through
// domrt/html directly on the client: look the input up by InputID and
// call its AsInput().Files(), or attach domrt/html's own
// Element.OnDrop to the dropzone by DropzoneID for real drag-and-drop
// file access (html.DragEvent.DataTransfer.Files()). FileUploader
// itself only renders the widget and prevents the browser's default
// drag-over/drop navigation.
type FileUploaderProps struct {
	DropzoneID string // id on the dropzone, for a caller to attach html.Element.OnDrop
	InputID    string // id on the hidden file input, for a caller to read .Files() after a change event

	Accept   string // e.g. "image/*" or ".pdf,.docx"; "" allows any file
	Multiple bool
	Disabled bool

	ShowProgress  bool    // render a progress bar at all -- the "without progress" variant just leaves this false
	Progress      float64 // 0-100, ignored when Indeterminate
	Indeterminate bool    // show a moving/indeterminate bar instead of a fixed percentage

	OnFilesSelected xango.EventHandler // fired on the input's change event
}

// FileUploader renders a dropzone that's also a native file-input
// label (clicking anywhere on it opens the file browser, no JS
// needed for that part) plus an optional progress bar.
func FileUploader(props FileUploaderProps) xango.Node {
	inputAttrs := []xango.Attr{xango.A("type", "file"), xango.A("class", "gj-file-uploader-input")}
	if props.InputID != "" {
		inputAttrs = append(inputAttrs, xango.A("id", props.InputID))
	}
	if props.Accept != "" {
		inputAttrs = append(inputAttrs, xango.A("accept", props.Accept))
	}
	if props.Multiple {
		inputAttrs = append(inputAttrs, xango.A("multiple", "multiple"))
	}
	if props.Disabled {
		inputAttrs = append(inputAttrs, xango.A("disabled", "disabled"))
	}
	if props.OnFilesSelected != nil {
		inputAttrs = append(inputAttrs, xango.On("change", props.OnFilesSelected))
	}

	dropzoneAttrs := []xango.Attr{xango.A("class", "gj-file-uploader-dropzone")}
	if props.DropzoneID != "" {
		dropzoneAttrs = append(dropzoneAttrs, xango.A("id", props.DropzoneID))
	}
	dropzoneAttrs = append(dropzoneAttrs,
		xango.On("dragover", func(e xango.Event) { e.PreventDefault() }),
		xango.On("drop", func(e xango.Event) { e.PreventDefault() }),
	)

	children := []xango.Node{
		xango.El("input", inputAttrs),
		xango.El("span", []xango.Attr{xango.A("class", "gj-file-uploader-hint")}, xango.Text("Click or drag a file here")),
	}
	if props.ShowProgress {
		children = append(children, fileUploaderProgress(props.Progress, props.Indeterminate))
	}
	return xango.El("label", dropzoneAttrs, children...)
}

func fileUploaderProgress(progress float64, indeterminate bool) xango.Node {
	class := "gj-file-uploader-progress"
	if indeterminate {
		class += " gj-file-uploader-progress-indeterminate"
	}
	attrs := []xango.Attr{xango.A("class", class), xango.A("role", "progressbar")}
	if indeterminate {
		return xango.El("div", attrs, xango.El("div", []xango.Attr{xango.A("class", "gj-file-uploader-progress-bar")}))
	}
	pct := progress
	if pct < 0 {
		pct = 0
	}
	if pct > 100 {
		pct = 100
	}
	attrs = append(attrs, xango.A("aria-valuenow", formatFloat(pct)), xango.A("aria-valuemin", "0"), xango.A("aria-valuemax", "100"))
	return xango.El("div", attrs, xango.El("div",
		[]xango.Attr{xango.A("class", "gj-file-uploader-progress-bar"), xango.A("style", fmt.Sprintf("width: %.0f%%", pct))}))
}
