package components

import "github.com/elaous/gojiberry/gox"

// DialogProps configures Dialog.
type DialogProps struct {
	Open    bool
	Role    string // "dialog" (default) or "alertdialog"; see Modal.Role
	Title   string
	Body    []gox.Node
	Actions []gox.Node // typically Button components; rendered right-aligned in a footer
	OnClose func()     // backdrop-click to close; nil disables it
}

// Dialog is Modal with the common title/body/footer-actions shape.
func Dialog(props DialogProps) gox.Node {
	content := []gox.Node{
		gox.El("h2", []gox.Attr{gox.A("class", "gj-dialog-title")}, gox.Text(props.Title)),
		gox.El("div", []gox.Attr{gox.A("class", "gj-dialog-body")}, props.Body...),
	}
	if len(props.Actions) > 0 {
		content = append(content, gox.El("div", []gox.Attr{gox.A("class", "gj-dialog-actions")}, props.Actions...))
	}
	return Modal(ModalProps{
		Open:    props.Open,
		Role:    props.Role,
		Label:   props.Title,
		Content: content,
		OnClose: props.OnClose,
	})
}
