package components

import "github.com/elaous/gojiberry/gox"

// AvatarSize selects Avatar's rendered size.
type AvatarSize string

const (
	AvatarSm AvatarSize = "sm"
	AvatarMd AvatarSize = "md"
	AvatarLg AvatarSize = "lg"
)

// AvatarProps configures Avatar.
type AvatarProps struct {
	Src      string // image URL; "" falls back to rendering Initials instead
	Alt      string
	Initials string
	Size     AvatarSize // defaults to AvatarMd
}

// Avatar renders a profile picture, or a colored circle of Initials
// when Src is empty (e.g. the user hasn't uploaded one).
func Avatar(props AvatarProps) gox.Node {
	size := props.Size
	if size == "" {
		size = AvatarMd
	}
	class := "gj-avatar gj-avatar-" + string(size)
	if props.Src != "" {
		return gox.El("img", []gox.Attr{gox.A("class", class), gox.A("src", props.Src), gox.A("alt", props.Alt)})
	}
	return gox.El("span", []gox.Attr{gox.A("class", class), gox.A("role", "img"), gox.A("aria-label", props.Alt)}, gox.Text(props.Initials))
}
