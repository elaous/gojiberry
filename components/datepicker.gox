package components

import "github.com/elaous/gojiberry/gox"

// DatePickerProps configures DatePicker.
type DatePickerProps struct {
	Value    string // "YYYY-MM-DD"
	Min, Max string // optional bounds, same format; "" for no bound
	Disabled bool
	OnChange func(value string)
}

// DatePicker renders a styled native date input, letting the browser
// handle the actual calendar UI/locale formatting/keyboard input.
func DatePicker(props DatePickerProps) gox.Node {
	attrs := []gox.Attr{
		gox.A("type", "date"),
		gox.A("class", "gj-datepicker"),
		gox.A("value", props.Value),
	}
	if props.Min != "" {
		attrs = append(attrs, gox.A("min", props.Min))
	}
	if props.Max != "" {
		attrs = append(attrs, gox.A("max", props.Max))
	}
	if props.Disabled {
		attrs = append(attrs, gox.A("disabled", "disabled"))
	}
	if props.OnChange != nil {
		attrs = append(attrs, gox.On("change", func(e gox.Event) { props.OnChange(gox.EventValue[string](e)) }))
	}
	return gox.El("input", attrs)
}
