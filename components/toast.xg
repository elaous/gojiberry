package components

import "github.com/elaous/gojiberry/xango"

// ToastVariant selects Toast's color/severity.
type ToastVariant string

const (
	ToastInfo    ToastVariant = "info"
	ToastSuccess ToastVariant = "success"
	ToastWarning ToastVariant = "warning"
	ToastError   ToastVariant = "error"
)

// ToastProps configures Toast.
type ToastProps struct {
	Open    bool
	Message string
	Variant ToastVariant // defaults to ToastInfo
	OnClose func()       // nil hides the close button
}

func Toast(props ToastProps) xango.Node {
	if !props.Open {
		return xango.Frag()
	}
	variant := props.Variant
	if variant == "" {
		variant = ToastInfo
	}
	children := []xango.Node{
		xango.El("span", []xango.Attr{xango.A("class", "gj-toast-message")}, xango.Text(props.Message)),
	}
	if props.OnClose != nil {
		children = append(children, xango.El("button",
			[]xango.Attr{
				xango.A("class", "gj-toast-close"),
				xango.A("type", "button"),
				xango.A("aria-label", "Dismiss"),
				xango.On("click", func(xango.Event) { props.OnClose() }),
			},
			xango.Text("×")))
	}
	return xango.El("div",
		[]xango.Attr{xango.A("class", "gj-toast gj-toast-"+string(variant)), xango.A("role", "status"), xango.A("aria-live", "polite")},
		children...)
}
