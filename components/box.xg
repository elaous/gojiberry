package components

import (
	"strings"

	"github.com/elaous/gojiberry/xango"
)

// BoxDivision is one of Box's sub-boxes.
type BoxDivision struct {
	Height  string
	Content []xango.Node
}

// BoxProps configures Box.
type BoxProps struct {
	Height string
	Divisions []BoxDivision
}

func Box(props BoxProps) xango.Node {
	height := props.Height
	if height == "" {
		height = "100%"
	}
	rows := make([]string, len(props.Divisions))
	for i, d := range props.Divisions {
		if d.Height == "" {
			rows[i] = "1fr"
		} else {
			rows[i] = d.Height
		}
	}
	style := "height:" + height + ";grid-template-rows:" + strings.Join(rows, " ") + ";"

	children := make([]xango.Node, len(props.Divisions))
	for i, d := range props.Divisions {
		children[i] = <div class="gj-box-division">{d.Content}</div>
	}
	return <div class="gj-box" style={style}>{children}</div>
}
