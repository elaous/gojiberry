package components

import "github.com/elaous/gojiberry/gox"

// CheckboxOption is one choice in a CheckboxGroup.
type CheckboxOption struct {
	Value string
	Label string
}

// CheckboxGroupProps configures CheckboxGroup.
type CheckboxGroupProps struct {
	Options  []CheckboxOption
	Selected []string // the currently checked options' Values, in any order
	Disabled bool
	OnChange func(value string, checked bool) // called with the toggled option's Value and its new state
}

// CheckboxGroup renders a set of independent checkboxes -- unlike
// RadioGroup, any number (including all or none) may be checked at
// once.
func CheckboxGroup(props CheckboxGroupProps) gox.Node {
	selected := make(map[string]bool, len(props.Selected))
	for _, v := range props.Selected {
		selected[v] = true
	}
	var items []gox.Node
	for _, opt := range props.Options {
		checked := selected[opt.Value]
		attrs := []gox.Attr{gox.A("type", "checkbox"), gox.A("class", "gj-checkbox-input")}
		if checked {
			attrs = append(attrs, gox.A("checked", "checked"))
		}
		if props.Disabled {
			attrs = append(attrs, gox.A("disabled", "disabled"))
		}
		if props.OnChange != nil {
			value := opt.Value
			attrs = append(attrs, gox.On("change", func(e gox.Event) { props.OnChange(value, e.Checked) }))
		}
		items = append(items, gox.El("label", []gox.Attr{gox.A("class", "gj-checkbox")},
			gox.El("input", attrs),
			gox.El("span", []gox.Attr{gox.A("class", "gj-checkbox-label")}, gox.Text(opt.Label)),
		))
	}
	return gox.El("div", []gox.Attr{gox.A("class", "gj-checkbox-group"), gox.A("role", "group")}, items...)
}
