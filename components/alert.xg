package components

import "github.com/elaous/gojiberry/xango"

// AlertProps configures Alert.
type AlertProps struct {
	Open    bool
	Title   string
	Message string
	OKLabel string // defaults to "OK"
	OnClose func()
}

// Alert is a Dialog preset for a single acknowledgment, rendered with
// role="alertdialog" (per ARIA, for a dialog demanding an immediate
// response) instead of Dialog's default role="dialog".
func Alert(props AlertProps) xango.Node {
	okLabel := props.OKLabel
	if okLabel == "" {
		okLabel = "OK"
	}
	onOK := func(xango.Event) {
		if props.OnClose != nil {
			props.OnClose()
		}
	}
	return <Dialog open={props.Open} role="alertdialog" title={props.Title} body={[]xango.Node{xango.Text(props.Message)}}
		actions={[]xango.Node{<Button label={okLabel} variant={ButtonPrimary} onClick={onOK} />}}
		onClose={props.OnClose} />
}
