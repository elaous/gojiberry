package components

import (
	"sort"
	"strings"

	"github.com/elaous/xango"
)

// ThemeMode selects one of Theme's own built-in --gj-* palettes.
type ThemeMode string

const (
	ThemeLight ThemeMode = "light"
	ThemeDark  ThemeMode = "dark"
)

// ThemeProps configures Theme.
type ThemeProps struct {
	Mode ThemeMode
	Custom   map[string]string
	Children []xango.Node
}

func Theme(props ThemeProps) xango.Node {
	class := "gj-theme-light"
	if props.Mode == ThemeDark {
		class = "gj-theme-dark"
	}
	attrs := []xango.Attr{xango.A("class", class)}
	if len(props.Custom) > 0 {
		attrs = append(attrs, xango.A("style", themeCustomPropertyStyle(props.Custom)))
	}
	return xango.El("div", attrs, props.Children...)
}

func themeCustomPropertyStyle(overrides map[string]string) string {
	keys := make([]string, 0, len(overrides))
	for k := range overrides {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	var b strings.Builder
	for i, k := range keys {
		if i > 0 {
			b.WriteString(" ")
		}
		b.WriteString(k)
		b.WriteString(": ")
		b.WriteString(overrides[k])
		b.WriteString(";")
	}
	return b.String()
}
