package components

import "github.com/elaous/xango"

// RadioOption is one choice in a RadioGroup.
type RadioOption struct {
	Value string
	Label string
}

// RadioGroupProps configures RadioGroup.
type RadioGroupProps struct {
	Name     string // shared "name" so the browser only allows one checked at a time
	Options  []RadioOption
	Selected string // the currently selected option's Value
	Disabled bool
	OnChange func(value string) // called with the newly selected option's Value
}

// RadioGroup renders a set of mutually exclusive radio buttons.
func RadioGroup(props RadioGroupProps) xango.Node {
	var items []xango.Node
	for _, opt := range props.Options {
		id := props.Name + "-" + opt.Value
		attrs := []xango.Attr{
			xango.A("type", "radio"),
			xango.A("name", props.Name),
			xango.A("id", id),
			xango.A("value", opt.Value),
		}
		if opt.Value == props.Selected {
			attrs = append(attrs, xango.A("checked", "checked"))
		}
		if props.Disabled {
			attrs = append(attrs, xango.A("disabled", "disabled"))
		}
		if props.OnChange != nil {
			value := opt.Value
			attrs = append(attrs, xango.On("change", func(xango.Event) { props.OnChange(value) }))
		}
		items = append(items, xango.El("div", []xango.Attr{xango.A("class", "gj-radio-option")},
			xango.El("input", attrs),
			xango.El("label", []xango.Attr{xango.A("for", id)}, xango.Text(opt.Label)),
		))
	}
	return xango.El("div", []xango.Attr{xango.A("class", "gj-radio-group"), xango.A("role", "radiogroup")}, items...)
}
