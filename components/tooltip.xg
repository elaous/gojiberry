package components

import "github.com/elaous/gojiberry/xango"

type TooltipPlacement string

const (
	TooltipTop    TooltipPlacement = "top"
	TooltipBottom TooltipPlacement = "bottom"
	TooltipLeft   TooltipPlacement = "left"
	TooltipRight  TooltipPlacement = "right"
)

// TooltipProps configures Tooltip.
type TooltipProps struct {
	Content   string
	Placement TooltipPlacement // defaults to TooltipTop
	Children  []xango.Node       // whatever should trigger the tooltip on hover/focus
}

func Tooltip(props TooltipProps) xango.Node {
	placement := props.Placement
	if placement == "" {
		placement = TooltipTop
	}
	return <span class="gj-tooltip">
		{props.Children}
		<span class={"gj-tooltip-bubble gj-tooltip-" + string(placement)} role="tooltip">{props.Content}</span>
	</span>
}
