package components

import "github.com/elaous/gojiberry/xango"

// ColorPickerProps configures ColorPicker.
type ColorPickerProps struct {
	Value    string // "#rrggbb"
	Disabled bool
	Label    string
	OnChange func(value string)
}

func ColorPicker(props ColorPickerProps) xango.Node {
	attrs := []xango.Attr{
		xango.A("type", "color"),
		xango.A("class", "gj-colorpicker"),
		xango.A("value", props.Value),
	}
	if props.Label != "" {
		attrs = append(attrs, xango.A("aria-label", props.Label))
	}
	if props.Disabled {
		attrs = append(attrs, xango.A("disabled", "disabled"))
	}
	if props.OnChange != nil {
		attrs = append(attrs, xango.On("change", func(e xango.Event) { props.OnChange(xango.EventValue[string](e)) }))
	}
	return xango.El("input", attrs)
}
