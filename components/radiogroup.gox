package components

import "github.com/elaous/gojiberry/gox"

// RadioOption is one choice in a RadioGroup.
type RadioOption struct {
	Value string
	Label string
}

// RadioGroupProps configures RadioGroup.
type RadioGroupProps struct {
	Name     string // shared "name" so the browser only allows one checked at a time
	Options  []RadioOption
	Selected string // the currently selected option's Value
	Disabled bool
	OnChange func(value string) // called with the newly selected option's Value
}

// RadioGroup renders a set of mutually exclusive radio buttons.
func RadioGroup(props RadioGroupProps) gox.Node {
	var items []gox.Node
	for _, opt := range props.Options {
		id := props.Name + "-" + opt.Value
		attrs := []gox.Attr{
			gox.A("type", "radio"),
			gox.A("name", props.Name),
			gox.A("id", id),
			gox.A("value", opt.Value),
		}
		if opt.Value == props.Selected {
			attrs = append(attrs, gox.A("checked", "checked"))
		}
		if props.Disabled {
			attrs = append(attrs, gox.A("disabled", "disabled"))
		}
		if props.OnChange != nil {
			value := opt.Value
			attrs = append(attrs, gox.On("change", func(gox.Event) { props.OnChange(value) }))
		}
		items = append(items, gox.El("div", []gox.Attr{gox.A("class", "gj-radio-option")},
			gox.El("input", attrs),
			gox.El("label", []gox.Attr{gox.A("for", id)}, gox.Text(opt.Label)),
		))
	}
	return gox.El("div", []gox.Attr{gox.A("class", "gj-radio-group"), gox.A("role", "radiogroup")}, items...)
}
