package components

import (
	"fmt"

	"github.com/elaous/gojiberry/xango"
)

// ContextMenuItem is one entry in a ContextMenu.
type ContextMenuItem struct {
	Label    string
	Icon     *xango.Node // optional, rendered before Label
	Disabled bool
	OnSelect func()
}

// ContextMenuProps configures ContextMenu.
type ContextMenuProps struct {
	Items []ContextMenuItem
	Open  bool
	X, Y  float64 // viewport position to render at -- see html.Element.OnContextMenu

	// OnClose is called after an item is selected, and when the
	// full-viewport backdrop behind the menu is clicked (a click
	// anywhere outside it).
	OnClose func()
}

// ContextMenu renders a positioned menu (typically opened from a
// right-click -- see html.Element.OnContextMenu) plus a full-viewport
// backdrop that closes it on an outside click. Renders nothing when
// !Open.
func ContextMenu(props ContextMenuProps) xango.Node {
	if !props.Open {
		return xango.Frag()
	}

	var items []xango.Node
	for _, it := range props.Items {
		class := "gj-contextmenu-item"
		if it.Disabled {
			class += " gj-contextmenu-item-disabled"
		}
		attrs := []xango.Attr{xango.A("class", class), xango.A("role", "menuitem")}
		if it.Disabled {
			attrs = append(attrs, xango.A("aria-disabled", "true"))
		} else if it.OnSelect != nil {
			onSelect := it.OnSelect
			onClose := props.OnClose
			attrs = append(attrs, xango.On("click", func(xango.Event) {
				onSelect()
				if onClose != nil {
					onClose()
				}
			}))
		}
		var children []xango.Node
		if it.Icon != nil {
			children = append(children, xango.El("span", []xango.Attr{xango.A("class", "gj-contextmenu-icon")}, *it.Icon))
		}
		children = append(children, xango.El("span", []xango.Attr{xango.A("class", "gj-contextmenu-label")}, xango.Text(it.Label)))
		items = append(items, xango.El("div", attrs, children...))
	}

	backdropAttrs := []xango.Attr{xango.A("class", "gj-contextmenu-backdrop")}
	if props.OnClose != nil {
		backdropAttrs = append(backdropAttrs, xango.On("click", func(xango.Event) { props.OnClose() }))
	}

	return xango.Frag(
		xango.El("div", backdropAttrs),
		xango.El("div",
			[]xango.Attr{
				xango.A("class", "gj-contextmenu"),
				xango.A("role", "menu"),
				xango.A("style", fmt.Sprintf("left: %.0fpx; top: %.0fpx;", props.X, props.Y)),
			},
			items...),
	)
}
