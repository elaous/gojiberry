package components

import "github.com/elaous/gojiberry/gox"

// ImageZoomProps configures ImageZoom.
type ImageZoomProps struct {
	Src    string
	Alt    string
	Zoomed bool
	// OnToggle is called with true when the thumbnail is clicked, and
	// with false when the zoomed overlay (or its backdrop) is
	// clicked, closing it.
	OnToggle func(zoomed bool)
}

// ImageZoom renders a thumbnail that, when Zoomed, also shows a
// full-viewport overlay with the same image enlarged -- a Modal-style
// backdrop (see Modal's doc comment for why backdrop and content are
// DOM siblings, not nested: so a click on the enlarged image itself
// can't be mistaken for a click on the backdrop behind it).
func ImageZoom(props ImageZoomProps) gox.Node {
	thumbAttrs := []gox.Attr{gox.A("class", "gj-imagezoom-thumb"), gox.A("src", props.Src), gox.A("alt", props.Alt)}
	if props.OnToggle != nil {
		thumbAttrs = append(thumbAttrs, gox.On("click", func(gox.Event) { props.OnToggle(true) }))
	}
	thumb := gox.El("img", thumbAttrs)
	if !props.Zoomed {
		return gox.El("span", []gox.Attr{gox.A("class", "gj-imagezoom")}, thumb)
	}
	backdropAttrs := []gox.Attr{gox.A("class", "gj-imagezoom-backdrop")}
	if props.OnToggle != nil {
		backdropAttrs = append(backdropAttrs, gox.On("click", func(gox.Event) { props.OnToggle(false) }))
	}
	return gox.El("span", []gox.Attr{gox.A("class", "gj-imagezoom")},
		thumb,
		gox.El("div", backdropAttrs),
		gox.El("img", []gox.Attr{gox.A("class", "gj-imagezoom-full"), gox.A("src", props.Src), gox.A("alt", props.Alt)}),
	)
}
