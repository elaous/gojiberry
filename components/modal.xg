package components

import "github.com/elaous/gojiberry/xango"

// ModalProps configures Modal.
type ModalProps struct {
	Open bool
	Role string // "dialog" (default) or "alertdialog" for a Confirm/Alert-style prompt demanding an immediate response
	Label   string
	Content []xango.Node
	OnClose func()
}

// Modal renders a full-viewport backdrop plus a centered content box.
func Modal(props ModalProps) xango.Node {
	if !props.Open {
		return xango.Frag()
	}
	role := props.Role
	if role == "" {
		role = "dialog"
	}

	backdropAttrs := []xango.Attr{xango.A("class", "gj-modal-backdrop")}
	if props.OnClose != nil {
		backdropAttrs = append(backdropAttrs, xango.On("click", func(xango.Event) { props.OnClose() }))
	}

	boxAttrs := []xango.Attr{xango.A("class", "gj-modal"), xango.A("role", role), xango.A("aria-modal", "true"),
		xango.A("tabindex", "-1"), xango.A("data-gj-modal", "true"), ModalKeys(props.OnClose)}
	if props.Label != "" {
		boxAttrs = append(boxAttrs, xango.A("aria-label", props.Label))
	}

	return xango.Frag(
		xango.El("div", backdropAttrs),
		xango.El("div", boxAttrs, props.Content...),
	)
}
