package components

import "github.com/elaous/gojiberry/xango"

type PopoverPlacement string

const (
	PopoverBottom PopoverPlacement = "bottom"
	PopoverTop    PopoverPlacement = "top"
)

// PopoverProps configures Popover.
type PopoverProps struct {
	Trigger   []xango.Node
	Content   []xango.Node
	Open      bool
	Placement PopoverPlacement // defaults to PopoverBottom

	OnToggleOpen func(open bool) // called when Trigger is clicked
	OnClose func()
}

func Popover(props PopoverProps) xango.Node {
	placement := props.Placement
	if placement == "" {
		placement = PopoverBottom
	}

	triggerAttrs := []xango.Attr{xango.A("class", "gj-popover-trigger")}
	if props.OnToggleOpen != nil {
		open := props.Open
		triggerAttrs = append(triggerAttrs, xango.On("click", func(xango.Event) { props.OnToggleOpen(!open) }))
	}
	trigger := xango.El("span", triggerAttrs, props.Trigger...)

	if !props.Open {
		return xango.El("span", []xango.Attr{xango.A("class", "gj-popover")}, trigger)
	}

	backdropAttrs := []xango.Attr{xango.A("class", "gj-popover-backdrop")}
	if props.OnClose != nil {
		backdropAttrs = append(backdropAttrs, xango.On("click", func(xango.Event) { props.OnClose() }))
	}
	panel := xango.El("div",
		[]xango.Attr{xango.A("class", "gj-popover-panel gj-popover-"+string(placement)), xango.A("role", "dialog")},
		props.Content...)

	return xango.El("span", []xango.Attr{xango.A("class", "gj-popover")}, trigger, xango.El("div", backdropAttrs), panel)
}
