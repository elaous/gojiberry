package components

import "github.com/elaous/gojiberry/gox"

// BreadcrumbItem is one entry in a Breadcrumbs trail.
type BreadcrumbItem struct {
	Label string
	Href  string // "" renders a plain (non-link) span instead of an <a>

	// OnClick fires alongside a real navigation to Href -- e.g. to
	// drive client-side routing (see domrt/browser.Router) instead of
	// a full page load. Call e.PreventDefault() in it to suppress the
	// browser's own navigation.
	OnClick gox.EventHandler
}

// BreadcrumbsProps configures Breadcrumbs.
type BreadcrumbsProps struct {
	Items []BreadcrumbItem
}

// Breadcrumbs renders a trail of links with the last item marked as
// the current page (aria-current, and rendered as plain text even if
// it has an Href -- you're already there).
func Breadcrumbs(props BreadcrumbsProps) gox.Node {
	var items []gox.Node
	for i, it := range props.Items {
		last := i == len(props.Items)-1
		var content gox.Node
		if it.Href != "" && !last {
			attrs := []gox.Attr{gox.A("class", "gj-breadcrumb-link"), gox.A("href", it.Href)}
			if it.OnClick != nil {
				attrs = append(attrs, gox.On("click", it.OnClick))
			}
			content = gox.El("a", attrs, gox.Text(it.Label))
		} else {
			attrs := []gox.Attr{gox.A("class", "gj-breadcrumb-current")}
			if last {
				attrs = append(attrs, gox.A("aria-current", "page"))
			}
			content = gox.El("span", attrs, gox.Text(it.Label))
		}
		items = append(items, gox.El("li", []gox.Attr{gox.A("class", "gj-breadcrumb-item")}, content))
	}
	return gox.El("nav", []gox.Attr{gox.A("class", "gj-breadcrumbs"), gox.A("aria-label", "Breadcrumb")},
		gox.El("ol", []gox.Attr{gox.A("class", "gj-breadcrumbs-list")}, items...),
	)
}
