package components

import "github.com/elaous/gojiberry/xango"

// AvatarSize selects Avatar's rendered size.
type AvatarSize string

const (
	AvatarSm AvatarSize = "sm"
	AvatarMd AvatarSize = "md"
	AvatarLg AvatarSize = "lg"
)

// AvatarProps configures Avatar.
type AvatarProps struct {
	Src      string // image URL; "" falls back to rendering Initials instead
	Alt      string
	Initials string
	Size     AvatarSize // defaults to AvatarMd
}

func Avatar(props AvatarProps) xango.Node {
	size := props.Size
	if size == "" {
		size = AvatarMd
	}
	class := "gj-avatar gj-avatar-" + string(size)
	if props.Src != "" {
		return <img class={class} src={props.Src} alt={props.Alt} />
	}
	return <span class={class} role="img" aria-label={props.Alt}>{props.Initials}</span>
}
