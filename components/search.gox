package components

import "github.com/elaous/gojiberry/gox"

// SearchProps configures Search.
type SearchProps struct {
	Value       string
	Placeholder string
	Suggestions []string
	Open        bool // whether the suggestion list is shown
	Disabled    bool

	// OnChange fires on every keystroke. Filtering Suggestions (and
	// any debouncing of a remote lookup) is the caller's job -- Search
	// itself has no fetch/timer logic of its own, the same
	// "consumer drives the async part" split FileUploader uses for
	// reading files.
	OnChange func(value string)
	// OnSelect fires when a suggestion is clicked; the caller typically
	// sets Value to it and closes the list (Open: false).
	OnSelect func(suggestion string)
}

// Search renders a text input plus, when Open, a listbox of
// Suggestions below it -- a basic implementation of the ARIA combobox
// pattern (role/aria-* attributes only, no keyboard navigation of its
// own, the same scope RadioGroup/Dropdown/etc. keep to elsewhere in
// this package).
func Search(props SearchProps) gox.Node {
	inputAttrs := []gox.Attr{
		gox.A("type", "search"),
		gox.A("class", "gj-search-input"),
		gox.A("value", props.Value),
		gox.A("role", "combobox"),
		gox.A("aria-expanded", boolAttr(props.Open)),
		gox.A("aria-autocomplete", "list"),
	}
	if props.Placeholder != "" {
		inputAttrs = append(inputAttrs, gox.A("placeholder", props.Placeholder))
	}
	if props.Disabled {
		inputAttrs = append(inputAttrs, gox.A("disabled", "disabled"))
	}
	if props.OnChange != nil {
		inputAttrs = append(inputAttrs, gox.On("input", func(e gox.Event) { props.OnChange(gox.EventValue[string](e)) }))
	}
	children := []gox.Node{gox.El("input", inputAttrs)}

	if props.Open && len(props.Suggestions) > 0 {
		var items []gox.Node
		for _, s := range props.Suggestions {
			attrs := []gox.Attr{gox.A("class", "gj-search-option"), gox.A("role", "option")}
			if props.OnSelect != nil {
				suggestion := s
				attrs = append(attrs, gox.On("click", func(gox.Event) { props.OnSelect(suggestion) }))
			}
			items = append(items, gox.El("div", attrs, gox.Text(s)))
		}
		children = append(children, gox.El("div", []gox.Attr{gox.A("class", "gj-search-list"), gox.A("role", "listbox")}, items...))
	}
	return gox.El("div", []gox.Attr{gox.A("class", "gj-search")}, children...)
}
