package components

import (
	"fmt"

	"github.com/elaous/gojiberry/gox"
)

// CarouselProps configures Carousel.
type CarouselProps struct {
	Slides []gox.Node
	Active int

	OnPrev   func()             // called when the previous-slide arrow is clicked
	OnNext   func()             // called when the next-slide arrow is clicked
	OnSelect func(index int) // called when a dot is clicked
}

// Carousel renders a single active slide, prev/next arrows, and a dot
// per slide for direct navigation. All slides are rendered (the
// inactive ones aria-hidden) so this works before any client-side
// hydration runs, with CSS choosing which one shows.
func Carousel(props CarouselProps) gox.Node {
	var slideNodes []gox.Node
	for i, s := range props.Slides {
		active := i == props.Active
		class := "gj-carousel-slide"
		if active {
			class += " gj-carousel-slide-active"
		}
		slideNodes = append(slideNodes, gox.El("div",
			[]gox.Attr{gox.A("class", class), gox.A("aria-hidden", boolAttr(!active))}, s))
	}

	var dots []gox.Node
	for i := range props.Slides {
		active := i == props.Active
		class := "gj-carousel-dot"
		if active {
			class += " gj-carousel-dot-active"
		}
		dotAttrs := []gox.Attr{
			gox.A("class", class),
			gox.A("type", "button"),
			gox.A("aria-label", fmt.Sprintf("Go to slide %d", i+1)),
			gox.A("aria-current", boolAttr(active)),
		}
		if props.OnSelect != nil {
			index := i
			dotAttrs = append(dotAttrs, gox.On("click", func(gox.Event) { props.OnSelect(index) }))
		}
		dots = append(dots, gox.El("button", dotAttrs))
	}

	prevAttrs := []gox.Attr{gox.A("class", "gj-carousel-prev"), gox.A("type", "button"), gox.A("aria-label", "Previous slide")}
	if props.OnPrev != nil {
		prevAttrs = append(prevAttrs, gox.On("click", func(gox.Event) { props.OnPrev() }))
	}
	nextAttrs := []gox.Attr{gox.A("class", "gj-carousel-next"), gox.A("type", "button"), gox.A("aria-label", "Next slide")}
	if props.OnNext != nil {
		nextAttrs = append(nextAttrs, gox.On("click", func(gox.Event) { props.OnNext() }))
	}

	return gox.El("div", []gox.Attr{gox.A("class", "gj-carousel")},
		gox.El("div", []gox.Attr{gox.A("class", "gj-carousel-track")}, slideNodes...),
		gox.El("button", prevAttrs, gox.Text("‹")),
		gox.El("button", nextAttrs, gox.Text("›")),
		gox.El("div", []gox.Attr{gox.A("class", "gj-carousel-dots")}, dots...),
	)
}
