// Package components is a small library of ready-made xango components:
// plain Go functions taking a typed props struct and returning a
// xango.Node, the same shape as any other component in this framework
// (see the root README's "Components" section). None of them import
// domrt or syscall/js directly -- interactive ones take the current
// state and On* event handlers as props (the same controlled-component
// pattern the wasm-counter example uses), so a single component works
// unchanged for SSR-only pages and for a WASM page driving it with
// domrt.Mount/Update.
package components

import "github.com/elaous/gojiberry/xango"

// LinkProps configures Link.
type LinkProps struct {
	Href     string
	Target   string // e.g. "_blank"; "" stays in the same tab
	Disabled bool
	Children []xango.Node
}

// Link renders a styled <a>. A disabled link renders as a
// non-interactive <span> instead of an <a> without an href, since an
// anchor's disabled-looking states aren't real disabled controls to
// assistive tech the way a <button disabled> is.
func Link(props LinkProps) xango.Node {
	if props.Disabled {
		return <span class="gj-link gj-link-disabled" aria-disabled="true">{props.Children}</span>
	}
	attrs := []xango.Attr{xango.A("class", "gj-link"), xango.A("href", props.Href)}
	if props.Target != "" {
		attrs = append(attrs, xango.A("target", props.Target))
		if props.Target == "_blank" {
			attrs = append(attrs, xango.A("rel", "noopener noreferrer"))
		}
	}
	return xango.El("a", attrs, props.Children...)
}
