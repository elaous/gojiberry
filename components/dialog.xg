package components

import "github.com/elaous/xango"

// DialogProps configures Dialog.
type DialogProps struct {
	Open    bool
	Role    string // "dialog" (default) or "alertdialog"; see Modal.Role
	Title   string
	Body    []xango.Node
	Actions []xango.Node // typically Button components; rendered right-aligned in a footer
	OnClose func()     // backdrop-click to close; nil disables it
}

// Dialog is Modal with the common title/body/footer-actions shape.
func Dialog(props DialogProps) xango.Node {
	content := []xango.Node{
		<h2 class="gj-dialog-title">{props.Title}</h2>,
		<div class="gj-dialog-body">{props.Body}</div>,
	}
	if len(props.Actions) > 0 {
		content = append(content, <div class="gj-dialog-actions">{props.Actions}</div>)
	}
	return <Modal open={props.Open} role={props.Role} label={props.Title} content={content} onClose={props.OnClose} />
}
