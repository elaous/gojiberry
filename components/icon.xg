package components

import (
	"strconv"

	"github.com/elaous/gojiberry/xango"
)

// IconName selects one of Icon's built-in glyphs.
type IconName string

const (
	IconCheck        IconName = "check"
	IconClose        IconName = "close"
	IconChevronUp    IconName = "chevron-up"
	IconChevronDown  IconName = "chevron-down"
	IconChevronLeft  IconName = "chevron-left"
	IconChevronRight IconName = "chevron-right"
	IconPlus         IconName = "plus"
	IconMinus        IconName = "minus"
	IconMenu         IconName = "menu"
	IconStar         IconName = "star"
)

var iconGlyphs = map[IconName]string{
	IconCheck:        "✓", // ✓
	IconClose:        "×", // ×  -- same glyph Chip/Toast's own close buttons already use
	IconChevronUp:    "▲", // ▲
	IconChevronDown:  "▼", // ▼
	IconChevronLeft:  "◀", // ◀
	IconChevronRight: "▶", // ▶
	IconPlus:         "+",
	IconMinus:        "-",
	IconMenu:         "☰", // ☰
	IconStar:         "★", // ★
}

// IconProps configures Icon.
type IconProps struct {
	Name IconName // one of the built-in names above; ignored if Glyph is set
	Glyph string
	Size  int    // px, defaults to 20
	Color string // defaults to inheriting the surrounding text color
	// Label is the icon's accessible name.
	Label string
}

func Icon(props IconProps) xango.Node {
	glyph := props.Glyph
	if glyph == "" {
		glyph = iconGlyphs[props.Name]
	}
	size := props.Size
	if size == 0 {
		size = 20
	}
	attrs := []xango.Attr{
		xango.A("class", "gj-icon"),
		xango.A("style", "font-size:"+strconv.Itoa(size)+"px"+colorStyle(props.Color)),
	}
	if props.Label != "" {
		attrs = append(attrs, xango.A("role", "img"), xango.A("aria-label", props.Label))
	} else {
		attrs = append(attrs, xango.A("aria-hidden", "true"))
	}
	return xango.El("span", attrs, xango.Text(glyph))
}

func colorStyle(color string) string {
	if color == "" {
		return ""
	}
	return ";color:" + color
}
