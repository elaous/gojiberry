package components

// The components' stylesheets, registered with the program by blank CSS
// imports: xango.Document puts them in a page's head and domrt.Mount
// installs them in the browser, so importing this package is enough --
// no <link> tags or copying .css files around. base.css (the design
// tokens and shared keyframes) comes first.
import (
	_ "github.com/elaous/gojiberry/components/base.css"
	_ "github.com/elaous/gojiberry/components/a11y.css"
	_ "github.com/elaous/gojiberry/components/accordion.css"
	_ "github.com/elaous/gojiberry/components/avatar.css"
	_ "github.com/elaous/gojiberry/components/box.css"
	_ "github.com/elaous/gojiberry/components/breadcrumbs.css"
	_ "github.com/elaous/gojiberry/components/button.css"
	_ "github.com/elaous/gojiberry/components/carousel.css"
	_ "github.com/elaous/gojiberry/components/checkbox.css"
	_ "github.com/elaous/gojiberry/components/checkboxgroup.css"
	_ "github.com/elaous/gojiberry/components/chip.css"
	_ "github.com/elaous/gojiberry/components/presence.css"
	_ "github.com/elaous/gojiberry/components/outline.css"
	_ "github.com/elaous/gojiberry/components/comments.css"
	_ "github.com/elaous/gojiberry/components/collab.css"
	_ "github.com/elaous/gojiberry/components/colorpicker.css"
	_ "github.com/elaous/gojiberry/components/contextmenu.css"
	_ "github.com/elaous/gojiberry/components/datatable.css"
	_ "github.com/elaous/gojiberry/components/datepicker.css"
	_ "github.com/elaous/gojiberry/components/dialog.css"
	_ "github.com/elaous/gojiberry/components/documentview.css"
	_ "github.com/elaous/gojiberry/components/dropdown.css"
	_ "github.com/elaous/gojiberry/components/fileuploader.css"
	_ "github.com/elaous/gojiberry/components/findreplace.css"
	_ "github.com/elaous/gojiberry/components/floating.css"
	_ "github.com/elaous/gojiberry/components/fontselector.css"
	_ "github.com/elaous/gojiberry/components/spellpanel.css"
	_ "github.com/elaous/gojiberry/components/languagepanel.css"
	_ "github.com/elaous/gojiberry/components/grid.css"
	_ "github.com/elaous/gojiberry/components/icon.css"
	_ "github.com/elaous/gojiberry/components/imagezoom.css"
	_ "github.com/elaous/gojiberry/components/keybindings.css"
	_ "github.com/elaous/gojiberry/components/link.css"
	_ "github.com/elaous/gojiberry/components/linkpreview.css"
	_ "github.com/elaous/gojiberry/components/loader.css"
	_ "github.com/elaous/gojiberry/components/menu.css"
	_ "github.com/elaous/gojiberry/components/modal.css"
	_ "github.com/elaous/gojiberry/components/otpinput.css"
	_ "github.com/elaous/gojiberry/components/pagination.css"
	_ "github.com/elaous/gojiberry/components/popover.css"
	_ "github.com/elaous/gojiberry/components/progress.css"
	_ "github.com/elaous/gojiberry/components/radiogroup.css"
