package components

import (
	"strconv"

	"github.com/elaous/gojiberry/gox"
)

// DataTableColumn is one column header.
type DataTableColumn struct {
	Key      string // stable identifier threaded back through OnSort
	Header   string
	Sortable bool
}

// DataTableRow is one already-rendered row. DataTable has no notion
// of the caller's own row type -- there's no way to write a generic
// component's own type parameter into the .gox tag syntax every other
// component here is invoked through (`<DataTable columns=... />`), so
// (like Tabs' own Tab.Content, DropdownOption's own Icon) the caller
// turns each real row into one of these instead: ID is this row's own
// stable identity (selection tracking, and the keyed <tr> reconciliation
// DataTable's own render gives each row for free), Cells is the row's
// own already-rendered content, one per Columns entry, in the same
// order.
type DataTableRow struct {
	ID    string
	Cells []gox.Node
}

// DataTableProps configures DataTable.
type DataTableProps struct {
	Columns []DataTableColumn
	Rows    []DataTableRow

	// Selectable shows a checkbox column -- one per row plus a
	// select-all checkbox in the header -- reusing the same plain
	// checkbox markup Checkbox/CheckboxGroup already render rather
	// than a new selection primitive.
	Selectable     bool
	Selected       []string // currently-checked Rows' own IDs
	OnSelectChange func(id string, checked bool)
	OnSelectAll    func(checked bool)

	// SortKey/SortDesc/OnSort: DataTable only shows which column (if
	// any) is currently sorted and which direction, and fires OnSort
	// with the clicked column's own Key -- actually reordering Rows
	// (and deciding whether clicking an already-sorted column flips
	// SortDesc or clears it) is the caller's job, the same
	// caller-drives-it split every controlled component in this
	// package already takes.
	SortKey  string
	SortDesc bool
	OnSort   func(key string)

	// Search, if non-nil, renders a Search bar above the table --
	// filtering Rows against its own Value is, again, the caller's job.
	Search *SearchProps

	// RowActions, given a row's own ID, returns its own per-row action
	// buttons (edit/delete/...) as one trailing column -- present only
	// when RowActions is non-nil.
	RowActions func(id string) []gox.Node

	// Pagination, if non-nil, renders Pagination (already exists)
	// below the table. Infinite scroll instead is the caller's own
	// job: an IntersectionObserver has no gox.Event of its own to
	// declare here (the same "needs a real DOM reference" split
	// OTPInput/FileUploader/ContextMenu already take), so DataTable
	// only ever wires the page-number variant directly.
	Pagination *PaginationProps

	// Empty replaces the table body with a single full-width message
	// when Rows is empty -- "No data" is used if nil.
	Empty *gox.Node
}

// DataTable renders a sortable, optionally-selectable, optionally-
// searchable/paginated table -- see components/datatable.css.
func DataTable(props DataTableProps) gox.Node {
	colCount := len(props.Columns)
	if props.Selectable {
		colCount++
	}
	if props.RowActions != nil {
		colCount++
	}

	selected := make(map[string]bool, len(props.Selected))
	for _, id := range props.Selected {
		selected[id] = true
	}
	allSelected := props.Selectable && len(props.Rows) > 0 && len(props.Selected) == len(props.Rows)

	var headerCells []gox.Node
	if props.Selectable {
		attrs := []gox.Attr{gox.A("type", "checkbox"), gox.A("class", "gj-checkbox-input"), gox.A("aria-label", "Select all rows")}
		if allSelected {
			attrs = append(attrs, gox.A("checked", "checked"))
		}
		if props.OnSelectAll != nil {
			attrs = append(attrs, gox.On("change", func(e gox.Event) { props.OnSelectAll(e.Checked) }))
		}
		headerCells = append(headerCells, gox.El("th", []gox.Attr{gox.A("class", "gj-datatable-select-col")}, gox.El("input", attrs)))
	}
	for _, col := range props.Columns {
		headerCells = append(headerCells, dataTableHeaderCell(col, props.SortKey, props.SortDesc, props.OnSort))
	}
	if props.RowActions != nil {
		headerCells = append(headerCells, gox.El("th", []gox.Attr{gox.A("class", "gj-datatable-actions-col")}, gox.Text("Actions")))
	}

	var bodyRows []gox.Node
	for _, row := range props.Rows {
		var cells []gox.Node
		if props.Selectable {
			checked := selected[row.ID]
			attrs := []gox.Attr{gox.A("type", "checkbox"), gox.A("class", "gj-checkbox-input"), gox.A("aria-label", "Select row")}
			if checked {
				attrs = append(attrs, gox.A("checked", "checked"))
			}
			if props.OnSelectChange != nil {
				id := row.ID
				attrs = append(attrs, gox.On("change", func(e gox.Event) { props.OnSelectChange(id, e.Checked) }))
			}
			cells = append(cells, gox.El("td", []gox.Attr{gox.A("class", "gj-datatable-select-col")}, gox.El("input", attrs)))
		}
		for _, cell := range row.Cells {
			cells = append(cells, gox.El("td", nil, cell))
		}
		if props.RowActions != nil {
			cells = append(cells, gox.El("td", []gox.Attr{gox.A("class", "gj-datatable-actions-col")}, props.RowActions(row.ID)...))
		}
		class := "gj-datatable-row"
		if props.Selectable && selected[row.ID] {
			class += " gj-datatable-row-selected"
		}
		bodyRows = append(bodyRows, gox.El("tr", []gox.Attr{gox.A("class", class)}, cells...).WithKey(row.ID))
	}
	if len(props.Rows) == 0 {
		empty := gox.Text("No data")
		if props.Empty != nil {
			empty = *props.Empty
		}
		bodyRows = []gox.Node{gox.El("tr", []gox.Attr{gox.A("class", "gj-datatable-empty-row")},
			gox.El("td", []gox.Attr{gox.A("colspan", strconv.Itoa(colCount))}, empty),
		)}
	}

	table := gox.El("table", []gox.Attr{gox.A("class", "gj-datatable")},
		gox.El("thead", nil, gox.El("tr", nil, headerCells...)),
		gox.El("tbody", nil, bodyRows...),
	)

	var children []gox.Node
	if props.Search != nil {
		children = append(children, Search(*props.Search))
	}
	children = append(children, table)
	if props.Pagination != nil {
		children = append(children, Pagination(*props.Pagination))
	}
	return gox.El("div", []gox.Attr{gox.A("class", "gj-datatable-wrap")}, children...)
}

// dataTableHeaderCell renders one <th> -- a plain header for a
// non-sortable column, or a clickable button carrying a triangle
// indicator and aria-sort for a sortable one.
func dataTableHeaderCell(col DataTableColumn, sortKey string, sortDesc bool, onSort func(key string)) gox.Node {
	if !col.Sortable {
		return gox.El("th", nil, gox.Text(col.Header))
	}
	active := col.Key == sortKey
	label := col.Header
	ariaSort := "none"
	if active {
		if sortDesc {
			label += " ▾"
			ariaSort = "descending"
		} else {
			label += " ▴"
			ariaSort = "ascending"
		}
	}
	attrs := []gox.Attr{gox.A("class", "gj-datatable-sort"), gox.A("type", "button")}
	if onSort != nil {
		key := col.Key
		attrs = append(attrs, gox.On("click", func(gox.Event) { onSort(key) }))
	}
	return gox.El("th", []gox.Attr{gox.A("aria-sort", ariaSort)},
		gox.El("button", attrs, gox.Text(label)),
	)
}
