package components

import "github.com/elaous/gojiberry/xango"

// LoaderSize selects Loader's size.
type LoaderSize string

const (
	LoaderSmall  LoaderSize = "sm"
	LoaderMedium LoaderSize = "md"
	LoaderLarge  LoaderSize = "lg"
)

// LoaderProps configures Loader.
type LoaderProps struct {
	Size  LoaderSize // defaults to LoaderMedium
	Label string     // accessible label; defaults to "Loading"
}

// Loader renders a spinning indicator for an in-progress operation
// with no known completion percentage -- see Progress for one that has one.
func Loader(props LoaderProps) xango.Node {
	size := props.Size
	if size == "" {
		size = LoaderMedium
	}
	label := props.Label
	if label == "" {
		label = "Loading"
	}
	return <span class={"gj-loader gj-loader-" + string(size)} role="status" aria-label={label} />
}
