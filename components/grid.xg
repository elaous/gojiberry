package components

import "github.com/elaous/xango"

// GridProps configures Grid.
type GridProps struct {
	Width string
	Columns string
	Gap      string
	Children []xango.Node
}

func Grid(props GridProps) xango.Node {
	width := props.Width
	if width == "" {
		width = "100%"
	}
	columns := props.Columns
	if columns == "" {
		columns = "repeat(auto-fill, minmax(200px, 1fr))"
	}
	style := "width:" + width + ";grid-template-columns:" + columns + ";"
	if props.Gap != "" {
		style += "gap:" + props.Gap + ";"
	}
	return <div class="gj-grid" style={style}>{props.Children}</div>
}
