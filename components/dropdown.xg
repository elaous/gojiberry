package components

import (
	"strings"

	"github.com/elaous/gojiberry/xango"
)

// DropdownOption is one choice in a Dropdown.
type DropdownOption struct {
	Value string
	Label string
	Icon  *xango.Node // optional, rendered before Label
}

// DropdownProps configures Dropdown. There's no native <select>
// equivalent that supports per-option icons, so both single- and
// multi-select modes use the same custom widget here (a native
// <select> is a better fit when icons aren't needed).
type DropdownProps struct {
	Options     []DropdownOption
	Selected    []string // selected Values; single-select just uses at most one
	Multiple    bool     // show a checkbox per option and allow more than one selected
	Open        bool     // whether the option list is currently shown
	Placeholder string   // shown on the closed control when nothing is selected

	OnToggleOpen func(open bool) // called when the control is clicked

	// OnSelect is called when an option is clicked. For single-select,
	// it should replace Selected and close the dropdown; for
	// multi-select, it should add/remove value from Selected and
	// typically leave it open.
	OnSelect func(value string)
}

// Dropdown renders a closed control button and, when Open, a listbox
// of options below it. This is a basic implementation of the ARIA
// listbox pattern (role/aria-* attributes only) -- it doesn't
// implement its own keyboard navigation, so pair it with native
// <button>/focus behavior for accessible keyboard use.
func Dropdown(props DropdownProps) xango.Node {
	selected := make(map[string]bool, len(props.Selected))
	for _, v := range props.Selected {
		selected[v] = true
	}

	label := props.Placeholder
	if len(props.Selected) > 0 {
		var labels []string
		for _, opt := range props.Options {
			if selected[opt.Value] {
				labels = append(labels, opt.Label)
			}
		}
		if len(labels) > 0 {
			label = strings.Join(labels, ", ")
		}
	}

	controlAttrs := []xango.Attr{
		xango.A("class", "gj-dropdown-control"),
		xango.A("type", "button"),
		xango.A("aria-haspopup", "listbox"),
		xango.A("aria-expanded", boolAttr(props.Open)),
	}
	if props.OnToggleOpen != nil {
		open := props.Open
		controlAttrs = append(controlAttrs, xango.On("click", func(xango.Event) { props.OnToggleOpen(!open) }))
	}
	control := xango.El("button", controlAttrs,
		xango.El("span", []xango.Attr{xango.A("class", "gj-dropdown-label")}, xango.Text(label)),
		xango.El("span", []xango.Attr{xango.A("class", "gj-dropdown-caret")}, xango.Text("▾")),
	)

	children := []xango.Node{control}
	if props.Open {
		var items []xango.Node
		for _, opt := range props.Options {
			isSelected := selected[opt.Value]
			class := "gj-dropdown-option"
			if isSelected {
				class += " gj-dropdown-option-selected"
			}
			itemAttrs := []xango.Attr{
				xango.A("class", class),
				xango.A("role", "option"),
				xango.A("aria-selected", boolAttr(isSelected)),
			}
			if props.OnSelect != nil {
				value := opt.Value
				itemAttrs = append(itemAttrs, xango.On("click", func(xango.Event) { props.OnSelect(value) }))
			}
			var itemChildren []xango.Node
			if props.Multiple {
				checkboxAttrs := []xango.Attr{xango.A("type", "checkbox"), xango.A("class", "gj-dropdown-checkbox"), xango.A("tabindex", "-1")}
				if isSelected {
					checkboxAttrs = append(checkboxAttrs, xango.A("checked", "checked"))
				}
				itemChildren = append(itemChildren, xango.El("input", checkboxAttrs))
			}
			if opt.Icon != nil {
				itemChildren = append(itemChildren, xango.El("span", []xango.Attr{xango.A("class", "gj-dropdown-icon")}, *opt.Icon))
			}
			itemChildren = append(itemChildren, xango.El("span", []xango.Attr{xango.A("class", "gj-dropdown-option-label")}, xango.Text(opt.Label)))
			items = append(items, xango.El("div", itemAttrs, itemChildren...))
		}
		children = append(children, xango.El("div",
			[]xango.Attr{xango.A("class", "gj-dropdown-list"), xango.A("role", "listbox"), xango.A("aria-multiselectable", boolAttr(props.Multiple))},
			items...))
	}
	return xango.El("div", []xango.Attr{xango.A("class", "gj-dropdown")}, children...)
}
