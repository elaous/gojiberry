package components

import "github.com/elaous/gojiberry/xango"

// ConfirmProps configures Confirm.
type ConfirmProps struct {
	Open         bool
	Title        string
	Message      string
	ConfirmLabel string // defaults to "OK"
	CancelLabel  string // defaults to "Cancel"
	OnConfirm    func()
	OnCancel     func() // also called on a backdrop click, the same as clicking Cancel
}

func Confirm(props ConfirmProps) xango.Node {
	confirmLabel := props.ConfirmLabel
	if confirmLabel == "" {
		confirmLabel = "OK"
	}
	cancelLabel := props.CancelLabel
	if cancelLabel == "" {
		cancelLabel = "Cancel"
	}
	onCancel := func(xango.Event) {
		if props.OnCancel != nil {
			props.OnCancel()
		}
	}
	onConfirm := func(xango.Event) {
		if props.OnConfirm != nil {
			props.OnConfirm()
		}
	}
	return <Dialog open={props.Open} role="alertdialog" title={props.Title} body={[]xango.Node{xango.Text(props.Message)}}
		actions={[]xango.Node{
			<Button label={cancelLabel} variant={ButtonSecondary} onClick={onCancel} />,
			<Button label={confirmLabel} variant={ButtonPrimary} onClick={onConfirm} />,
		}}
		onClose={props.OnCancel} />
}
