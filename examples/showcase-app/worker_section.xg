//go:build js && wasm

package main

import (
	"fmt"
	"syscall/js"

	"github.com/elaous/xango/domrt/browser"
	"github.com/elaous/xango/domrt/html"
)

func wireWorkerSection(document *html.Document) {
	w := browser.NewWorker("worker-bootstrap.js")

	w.OnMessage(func(data js.Value) {
		if data.Get("ready").Truthy() {
			w.PostMessage(map[string]any{"n": 100})
			return
		}
		n := data.Get("n").Int()
		count := data.Get("count").Int()
		document.GetElementByID("worker-result").SetTextContent(
			fmt.Sprintf("primes<=%d: %d", n, count))
	})
	w.OnError(func(err *html.JSError) {
		document.GetElementByID("worker-result").SetTextContent("error: " + err.Error())
	})

	document.GetElementByID("worker-send-50").AddEventListener("click", js.FuncOf(func(this js.Value, args []js.Value) any {
		w.PostMessage(map[string]any{"n": 50})
		return nil
	}))
}
