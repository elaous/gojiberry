//go:build js && wasm

package main

import (
	"fmt"
	"syscall/js"

	"github.com/elaous/xango/domrt/browser"
	"github.com/elaous/xango/domrt/html"
)

func wireTypedElementsSection(document *html.Document) {
	// CanvasElement: SetWidth/SetHeight plus GetContext2D's pixel readback.
	canvas := document.GetElementByID("typed-canvas").AsCanvas()
	canvas.SetWidth(50)
	canvas.SetHeight(40)
	ctx := canvas.GetContext2D()
	ctx.SetFillStyle("rgb(10, 20, 30)")
	ctx.FillRect(0, 0, 50, 40)
	px := ctx.GetImageData(25, 20, 1, 1)
	document.GetElementByID("typed-canvas-result").SetTextContent(
		fmt.Sprintf("%dx%d %d,%d,%d,%d", canvas.Width(), canvas.Height(), px.Pix[0], px.Pix[1], px.Pix[2], px.Pix[3]))

	// AnchorElement: Href/SetHref, Target/SetTarget, Rel/SetRel, Download/SetDownload.
	anchor := document.GetElementByID("typed-link").AsAnchor()
	anchor.SetTarget("_blank")
	anchor.SetRel("noopener")
	anchor.SetDownload("report.txt")
	document.GetElementByID("typed-anchor-result").SetTextContent(
		fmt.Sprintf("href=%s target=%s rel=%s download=%s", anchor.Href(), anchor.Target(), anchor.Rel(), anchor.Download()))

	button := document.GetElementByID("typed-btn").AsButton()
	button.SetType("button")
	clicks := 0
	button.AddEventListener("click", js.FuncOf(func(this js.Value, args []js.Value) any {
		clicks++
		document.GetElementByID("typed-button-result").SetTextContent(
			fmt.Sprintf("clicks=%d disabled=%v type=%s", clicks, button.Disabled(), button.Type()))
		return nil
	}))
	button.Click()

	button.SetTabIndex(0)
	button.SetTitle("a real title")
	button.SetStyleProperty("background-color", "rgb(1, 2, 3)")
	rect := button.BoundingRect()
	button.Focus()
	active := document.Get("activeElement")
	document.GetElementByID("typed-htmlelement-result").SetTextContent(
		fmt.Sprintf("tabindex=%d title=%s bg=%s hidden=%v rect=%v focused=%v",
			button.TabIndex(), button.GetTitle(), button.StyleProperty("background-color"),
			button.Hidden(), rect.Width > 0 && rect.Height > 0, active.Equal(button.JSValue())))
	button.Blur()

	// SelectElement: SetSelectedIndex, Multiple, and Options().
	sel := document.GetElementByID("typed-sel").AsSelect()
	sel.SetSelectedIndex(1)
	document.GetElementByID("typed-select-result").SetTextContent(
		fmt.Sprintf("index=%d value=%s options=%d multiple=%v", sel.SelectedIndex(), sel.GetValue(), len(sel.Options()), sel.Multiple()))

	// InputElement (checkbox): SetChecked/SetType/Disabled.
	checkbox := document.GetElementByID("typed-chk").AsInput()
	checkbox.SetChecked(true)
	document.GetElementByID("typed-checkbox-result").SetTextContent(
		fmt.Sprintf("checked=%v type=%s disabled=%v", checkbox.Checked(), checkbox.Type(), checkbox.Disabled()))

	fileInput := document.GetElementByID("typed-file").AsInput()
	fileInput.AddEventListener("change", js.FuncOf(func(this js.Value, args []js.Value) any {
		go func() {
			files := fileInput.Files()
			if len(files) == 0 {
				document.GetElementByID("typed-file-result").SetTextContent("no file")
				return
			}
			f := browser.WrapFile(files[0])
			text, err := f.ReadAsText()
			if err != nil {
				document.GetElementByID("typed-file-result").SetTextContent("error: " + err.Error())
				return
			}
			url := browser.CreateObjectURL(f)
			document.GetElementByID("typed-file-result").SetTextContent(
				fmt.Sprintf("name=%s size=%d type=%s text=%s url=%s", f.Name(), f.Size(), f.Type(), text, url[:5]))
			browser.RevokeObjectURL(url)
		}()
		return nil
	}))
}
