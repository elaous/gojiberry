//go:build js && wasm

// Command wasmclient is the xango-canvas autosave client: it debounces
// textarea edits into PUT /api/documents/{id} calls via
// domrt/browser.FetchOpts, and drives a small status indicator through
// domrt.Mount/Update so the diff/patch runtime -- not just fetch -- is
// exercised in this example too. It attaches to server-rendered
// markup (canvas/pages.xg's CanvasPage) rather than mounting the
// whole page itself, since the textarea is plain editable HTML, not a
// xango-managed subtree.
package main

import (
	"encoding/json"
	"syscall/js"
	"time"

	"github.com/elaous/gojiberry/domrt"
	"github.com/elaous/gojiberry/domrt/browser"
	"github.com/elaous/gojiberry/xango"
)

type saveRequest struct {
	Content string `json:"content"`
}

func StatusView(state string) xango.Node {
	return <span id="status">{state}</span>
}

func main() {
	document := browser.Document()
	app := document.GetElementByID("app")
	docID := app.Get("dataset").Get("docId").String()
	textarea := document.GetElementByID("canvas")
	statusContainer := document.GetElementByID("status").ParentElement()

	root := domrt.Mount(statusContainer.Element, StatusView("saved"))

	save := func() {
		content := textarea.GetValue()
		root.Update(StatusView("saving..."))
		go func() {
			body, err := json.Marshal(saveRequest{Content: content})
			if err != nil {
				root.Update(StatusView("error saving"))
				return
			}
			resp, err := browser.FetchOpts("/api/documents/"+docID, browser.FetchOptions{
				Method:  "PUT",
				Body:    string(body),
				Headers: map[string]string{"Content-Type": "application/json"},
			})
			if err != nil || !resp.OK {
				root.Update(StatusView("error saving"))
				return
			}
			root.Update(StatusView("saved"))
		}()
	}

	var debounce *time.Timer
	onInput := js.FuncOf(func(this js.Value, args []js.Value) any {
		root.Update(StatusView("editing..."))
		if debounce != nil {
			debounce.Stop()
		}
		debounce = time.AfterFunc(600*time.Millisecond, save)
		return nil
	})
	textarea.AddEventListener("input", onInput)

	select {} // keep the wasm program alive so the debounce timer and fetch callbacks keep firing
}
