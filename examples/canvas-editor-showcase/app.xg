package main

import (
	cv "github.com/elaous/gojiberry/canvas"
	canvas "github.com/elaous/gojiberry/canvas/xango"
	collab "github.com/elaous/gojiberry/collab/xango"
	"github.com/elaous/gojiberry/xango"
)

// Callbacks are how the canvas reports what happened in it.
type Callbacks struct {
	OnFlow      func(*cv.TextFlow)
	OnHoverLink func(url string)
	OnTurn      func(page int) // a corner tab of the spread view was pressed: show this page
	OnHoverComment func(id string)
	OnNote  func(*cv.FloatingText)
	OnTable func(*cv.Table)
}

func Doc(state State, cb Callbacks) xango.Node {
	return <canvas.Canvas width={920} height={640} mode={state.Mode} role={state.Role} features={state.Features()}>
		{shared(state, <canvas.ScrollView x={10} y={10} width={900} height={620} lockH={!state.Spread} typewriter={state.Typewriter} typewriterX={state.TypewriterX}>
			<canvas.TextFlow
				x={0} y={0} width={880}
				source={state.Source}
				items={state.Items}
				transform={state.Transform()}
				pageCount={state.Pages}
				pageWidth={state.PageWidth()} pageHeight={state.PageHeight()}
				spread={state.Spread}
				styles={state.Styles}
				autoClose={state.AutoClose()}
				textScale={state.TextScale}
				theme={state.Theme}
				peerPalette={state.PeerPalette}
				strongCaret={state.StrongCaret}
				hyphenator={state.Hyphenator()}
				margins={state.Setup.MarginList()}
				onChange={cb.OnFlow}
				onHoverLink={cb.OnHoverLink}
				onTurn={cb.OnTurn}
				comments={state.Comments}
				footnotes={state.Footnotes}
				author={state.Author}
				onHoverComment={cb.OnHoverComment}
				pages={func(page xango.Node, n int) xango.Node {
					return <>
						{runningHeader(state, n)}
						{page}
						{watermark(n)}
						{runningFooter(state, n)}
					</>
				}}
			/>
			{picture(state)}
			<canvas.FloatingText
				text={state.Note}
				opacity={0.95}
				anchor={&cv.Anchor{Page: 0, X: 330, Y: 250}}
				wrap
				vocabulary={[]string{"Gojiberry", "canvas", "feature"}}
				onChange={cb.OnNote}
			/>
			<canvas.Table
				cells={[][]string{{"Feature", "Keys"}, {"Multi-cursor", "Ctrl+D"}, {"Move line", "Alt+Up/Down"}}}
				anchor={&cv.Anchor{Page: 1, X: 60, Y: 200}}
				wrap
				onChange={cb.OnTable}
			/>
		</canvas.ScrollView>)}
	</canvas.Canvas>
}

func watermark(n int) xango.Node {
	if n == 0 {
		return <></>
	}
	return <canvas.Watermark text="DRAFT" opacity={0.12} />
}

// picture is the image, once it has loaded.
func picture(state State) xango.Node {
	if state.Image == nil {
		return <></>
	}
	return <canvas.Image
		source={state.Image}
		width={120} height={80}
		anchor={&cv.Anchor{Page: 1, X: 330, Y: 40}}
		wrap
		alt="A sample picture used to try text wrapping"
	/>
}

func shared(state State, content xango.Node) xango.Node {
	if state.Live == nil {
		return content
	}
	p := *state.Live
	p.Children = []xango.Node{content}
	return collab.Collab(p)
}
