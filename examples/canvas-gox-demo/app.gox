package main

import (
	canvas "github.com/elaous/gojiberry/canvas/gox"
	cv "github.com/elaous/gojiberry/canvas"
	"github.com/elaous/gojiberry/gox"
)

// Doc is the whole canvas, described as a gox tree: a text flow over
// three pages whose header, footer and page number come from the Pages
// render prop. The header changes on page 3 and numbering is off on
// page 1, to show per-page changes.
func Doc(state State) gox.Node {
	return <canvas.Canvas width={900} height={560} mode={state.Mode}>
		<canvas.TextFlow
			x={0} y={0} width={900}
			source={state.Source}
			transform={cv.Markdown{}}
			pageCount={state.Pages}
			pageWidth={560} pageHeight={380}
			margins={[]float64{60, 50, 60, 50}}
			pages={func(page gox.Node, n int) gox.Node {
				return <>
					{header(n)}
					{page}
					<canvas.Footer>
						{pageNumber(n)}
					</canvas.Footer>
				</>
			}}
		/>
	</canvas.Canvas>
}

func header(n int) gox.Node {
	if n >= 2 {
		return <canvas.Header text="Appendix" />
	}
	return <canvas.Header text="Gojiberry report" />
}

func pageNumber(n int) gox.Node {
	if n == 0 {
		return <canvas.PageNumber none />
	}
	return <canvas.PageNumber format="Page {n} of {total}" align={cv.AlignRight} />
}
