package main

import (
	cv "github.com/elaous/gojiberry/canvas"
	canvas "github.com/elaous/gojiberry/canvas/xango"
	"github.com/elaous/xango"
)

func Doc(state State) xango.Node {
	return <canvas.Canvas width={900} height={560} mode={state.Mode}>
		<canvas.TextFlow
			x={0} y={0} width={900}
			source={state.Source}
			transform={cv.Markdown{}}
			pageCount={state.Pages}
			pageWidth={560} pageHeight={380}
			margins={[]float64{60, 50, 60, 50}}
			pages={func(page xango.Node, n int) xango.Node {
				return <>
					{header(n)}
					{page}
					<canvas.Footer>
						{pageNumber(n)}
					</canvas.Footer>
				</>
			}}
		/>
	</canvas.Canvas>
}

func header(n int) xango.Node {
	if n >= 2 {
		return <canvas.Header text="Appendix" />
	}
	return <canvas.Header text="Gojiberry report" />
}

func pageNumber(n int) xango.Node {
	if n == 0 {
		return <canvas.PageNumber none />
	}
	return <canvas.PageNumber format="Page {n} of {total}" align={cv.AlignRight} />
}
