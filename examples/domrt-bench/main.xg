//go:build js && wasm

package main

import (
	"fmt"
	"strconv"
	"syscall/js"
	"time"

	"github.com/elaous/gojiberry/domrt"
	"github.com/elaous/gojiberry/xango"
)

const benchListSize = 100

func keyedList(keys []string, labelFor func(key string) string) xango.Node {
	items := make([]xango.Node, len(keys))
	for i, k := range keys {
		items[i] = xango.El("li", nil, xango.Text(labelFor(k))).WithKey(k)
	}
	return xango.El("ul", []xango.Attr{xango.A("id", "list")}, items...)
}

func initialKeys(n int) []string {
	keys := make([]string, n)
	for i := range keys {
		keys[i] = "item-" + strconv.Itoa(i)
	}
	return keys
}

// rotate left-rotates s by by positions in place.
func rotate(s []string, by int) {
	by = by % len(s)
	tmp := append([]string(nil), s[:by]...)
	copy(s, s[by:])
	copy(s[len(s)-by:], tmp)
}

func runBenchScenario(scenario string, n int) (float64, error) {
	container := js.Global().Get("document").Call("getElementById", "root")
	container.Set("innerHTML", "")

	keys := initialKeys(benchListSize)
	root := domrt.Mount(container, keyedList(keys, func(k string) string { return k }))

	start := time.Now()
	switch scenario {
	case "attrs-only":
		for i := 0; i < n; i++ {
			suffix := "-v" + strconv.Itoa(i)
			root.Update(keyedList(keys, func(k string) string { return k + suffix }))
		}
	case "keyed-reorder":
		shuffled := append([]string(nil), keys...)
		for i := 0; i < n; i++ {
			rotate(shuffled, 1)
			root.Update(keyedList(shuffled, func(k string) string { return k }))
		}
	case "append":
		grown := append([]string(nil), keys...)
		for i := 0; i < n; i++ {
			grown = append(grown, "new-"+strconv.Itoa(i))
			root.Update(keyedList(grown, func(k string) string { return k }))
		}
	case "full-replace":
		for i := 0; i < n; i++ {
			fresh := make([]string, benchListSize)
			for j := range fresh {
				fresh[j] = "gen" + strconv.Itoa(i) + "-" + strconv.Itoa(j)
			}
			root.Update(keyedList(fresh, func(k string) string { return k }))
		}
	default:
		return 0, fmt.Errorf("unknown scenario %q", scenario)
	}
	return float64(time.Since(start).Nanoseconds()), nil
}

func main() {
	js.Global().Set("runBench", js.FuncOf(func(this js.Value, args []js.Value) any {
		scenario := args[0].String()
		n := args[1].Int()
		ns, err := runBenchScenario(scenario, n)
		if err != nil {
			return js.ValueOf(map[string]any{"error": err.Error()})
		}
		return js.ValueOf(ns)
	}))

	select {} // keep the wasm program alive so window.runBench keeps working
}
