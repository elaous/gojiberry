// Package main demos the experimental JSON .(TypeName) annotation:
// gox infers a struct shape from config.json's own sample data and
// generates it, instead of the stable path's decoded `any` +
// hand-declared struct (see examples/resource-imports-demo). This is
// sample-based inference, not a schema -- see the README's
// Experimental section for the risk that entails, which is why this
// lives here instead of in the main examples.
//
// Regenerate with: go run ../../cmd/goxc -experimental .
package main

import (
	"fmt"
	"os"

	config.(SiteConfig) "config.json"

	"github.com/elaous/gojiberry/gox"
)

func Page(cfg SiteConfig) gox.Node {
	return <html>
		<body><h1>{cfg.Title}</h1></body>
	</html>
}

func main() {
	if err := gox.Render(os.Stdout, Page(config)); err != nil {
		fmt.Fprintln(os.Stderr, "render error:", err)
		os.Exit(1)
	}
	fmt.Println()
}
