# Copy to .env.local (git-ignored) and fill in what you need. Every line is optional: the stack runs
# with development defaults. A variable set in your shell overrides the same one here.
# Start the stack with: make stack-up

POSTGRES_PASSWORD=change-me

# Origins the browser pages are served from (the showcase is on http://localhost:8000).
GOJIBERRY_DOCSTORE_ALLOW_ORIGINS=http://localhost:8000
GOJIBERRY_COLLAB_ALLOW_ORIGINS=http://localhost:8000

# Shared secrets (use `openssl rand -hex 32`).
#GOJIBERRY_DOCSTORE_TOKEN=
#GOJIBERRY_COLLAB_TOKEN=
#GOJIBERRY_DOCSTORE_DIRECTORY_KEY=   # 32-byte seed in hex; turns the key directory on
#GOJIBERRY_DOCSTORE_DIRECTORY_ADMIN_TOKEN=

# E-mail: the Mailpit catcher in this stack (web UI http://localhost:8025).
#GOJIBERRY_MAIL_PROVIDER=smtp
#GOJIBERRY_MAIL_FROM=noreply@example.com
#GOJIBERRY_MAIL_SMTP_HOST=mailpit
#GOJIBERRY_MAIL_SMTP_PORT=1025
# Or Resend:
#GOJIBERRY_MAIL_PROVIDER=resend
#GOJIBERRY_MAIL_RESEND_API_KEY=re_...

# Optional services
#GOJIBERRY_FONTSERVER_GOOGLE_KEY=
#GOJIBERRY_TRANSLATESERVER_DEEPL_KEY=
